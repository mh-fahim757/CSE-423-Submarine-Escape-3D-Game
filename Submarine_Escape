def update_boss(dt):
    global boss
    if boss and boss["alive"]:
        dx = sub_pos[0] - boss["x"]
        dy = sub_pos[1] - boss["y"]
        dz = sub_pos[2] - boss["z"]

        dist = distance3([boss["x"], boss["y"], boss["z"]], sub_pos)
        if dist > 0:
            boss["x"] += (dx / dist) * boss_speed * dt
            boss["y"] += (dy / dist) * boss_speed * dt
            boss["z"] += (dz / dist) * boss_speed * dt

