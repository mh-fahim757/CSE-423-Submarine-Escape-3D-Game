def update_bubbles(dt):
    current_time = now_ms()

    # Update regular bubbles
    for b in bubbles[:]:
        b["x"] += b["vx"] * dt
        b["y"] += b["vy"] * dt
        b["z"] += b["vz"] * dt
        b["life_ms"] -= dt * 1000
        if b["life_ms"] <= 0:
            bubbles.remove(b)

    # Update trail bubbles
    for b in bubble_trail[:]:
        b["x"] += b["vx"] * dt
        b["y"] += b["vy"] * dt
        b["z"] += b["vz"] * dt
        b["life_ms"] -= dt * 1000
        if b["life_ms"] <= 0:
            bubble_trail.remove(b)

    # Update water particles
    for p in water_particles[:]:
        p["x"] += p["vx"] * dt
        p["y"] += p["vy"] * dt
        p["z"] += p["vz"] * dt
        p["life_ms"] -= dt * 1000
        if p["life_ms"] <= 0:
            water_particles.remove(p)

